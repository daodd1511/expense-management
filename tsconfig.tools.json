{
  "compilerOptions": {
    "lib": ["esnext"],
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["tools/**/*.ts", "vitest.tools.config.ts"]
}
