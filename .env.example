# Single env file for the whole repo. Copy to `.env` (gitignored).
# - `pnpm dev` / `pnpm dev:api`: the api loads this file via dotenv.
# - `pnpm dev:web`: Vite reads the VITE_* vars from here (envDir points at the root).
# - `docker compose up`: compose substitutes ${...} from here for local/manual runs.
# In production the deploy job injects these from GitHub repo secrets/variables,
# NOT from a committed file — see docs/deployment/self-hosting.md.

# Better Auth runtime (server-side; never expose the secret to the web bundle)
BETTER_AUTH_URL=https://wallet.example.com
BETTER_AUTH_SECRET=generate-a-random-secret-of-at-least-32-characters
# Exact reverse-proxy addresses allowed to supply forwarded client-IP headers.
AUTH_TRUSTED_PROXY_IPS=127.0.0.1,::1
# PORT=3000  # optional, defaults to 3000

# cloudflared (from the Cloudflare Zero Trust tunnel; docker compose only)
TUNNEL_TOKEN=your-cloudflare-tunnel-token
