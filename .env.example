# Single env file for the whole repo. Copy to `.env` (gitignored).
# - `pnpm dev` / `pnpm dev:api`: the api loads this file via dotenv.
# - `pnpm dev:web`: Vite reads the VITE_* vars from here (envDir points at the root).
# - `docker compose up`: compose substitutes ${...} from here for local/manual runs.
# In production these are set as Portainer stack environment variables, NOT committed.

# Supabase project URL — used by the web bundle (public by design) and reused by
# the api in dev (prod containers set SUPABASE_URL instead).
VITE_SUPABASE_URL=https://your-project.supabase.co

# Web build-time (compiled into the browser bundle; publishable/anon, public by design)
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# API runtime (server-side; keep secret)
SUPABASE_SECRET_KEY=your-service-role-or-secret-key
# PORT=3000  # optional, defaults to 3000

# cloudflared (from the Cloudflare Zero Trust tunnel; docker compose only)
TUNNEL_TOKEN=your-cloudflare-tunnel-token
