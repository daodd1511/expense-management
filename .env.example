# Copy to `.env` (gitignored). Use distinct random values for every password.
# The API loads this file for local source runs; Compose injects it at runtime.

# Local PostgreSQL 17
POSTGRES_DB=wallet
POSTGRES_PORT=5432
POSTGRES_PASSWORD=replace-with-a-random-migrator-password
WALLET_APP_PASSWORD=replace-with-a-distinct-app-password
WALLET_AUTH_PASSWORD=replace-with-a-distinct-auth-password
WALLET_RECOVERY_PASSWORD=replace-with-a-distinct-read-only-recovery-password

# Source-run API connections. Compose constructs equivalent in-network URLs.
APP_DATABASE_URL=postgres://wallet_app:replace-with-app-password@127.0.0.1:5432/wallet?sslmode=disable
AUTH_DATABASE_URL=postgres://wallet_auth:replace-with-auth-password@127.0.0.1:5432/wallet?sslmode=disable

# Better Auth runtime. Never expose BETTER_AUTH_SECRET to Vite or the browser bundle.
BETTER_AUTH_URL=https://wallet.example.com
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Compose defaults to the fixed local nginx address. Source runs may use loopback.
AUTH_TRUSTED_PROXY_IPS=172.30.0.20,127.0.0.1,::1

# Encrypted recovery and Cloudflare tunnel
AGE_RECIPIENT=age1replace-with-the-public-recovery-recipient
TUNNEL_TOKEN=replace-with-the-cloudflare-tunnel-token

# Optional public build metadata
VITE_API_BASE=/api
APP_COMMIT=
